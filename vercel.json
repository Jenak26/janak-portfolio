    {
      "source": "/oldsite",
      "destination": "/oldsite/",
      "permanent": false
    },
    {
      "source": "/deadlines",
      "destination": "/deadlines/",
      "permanent": false
    },
    {
      "source": "/deadlines-v1",
      "destination": "/deadlines-v1/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/oldsite/",
      "destination": "/oldsite/index.html"
